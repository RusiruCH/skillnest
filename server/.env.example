# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB)
MONGODB_URI=mongodb://localhost:27017/skillnest

# External Code Execution Sandbox (Piston API)
# Public Endpoint: https://emkc.org/api/v2/piston
PISTON_API_URL=https://emkc.org/api/v2/piston
# Optional API Key (leave empty for public instance)
PISTON_API_KEY=

# Shared Authentication Secret (Member 01 Integration)
JWT_SECRET=replace_with_shared_secret_from_member_01
